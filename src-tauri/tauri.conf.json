{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexto",
  "mainBinaryName": "Vexto",
  "version": "0.5.0",
  "identifier": "dev.vexto.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://vextoimg.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vexto",
    "shortDescription": "轻量工具集：划词翻译 / 截图 / 下载 / 局域网传文件",
    "longDescription": "Vexto 是一款常驻 Windows 托盘的轻量工具箱：划词翻译、截图翻译与截图、HTTP / BT / magnet 下载、局域网跨设备传文件。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aria2c"],
    "resources": ["licenses/*", "models/ocr/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
